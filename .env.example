APP_VERSION=1.0.0
APP_NAME='Shree Axar ERP'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Set APP_DEBUG=false in production
APP_URL=http://localhost:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shreeaxar_erp
DB_USERNAME=root
DB_PASSWORD=
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@shreeaxar.com
MAIL_FROM_NAME='Shree Axar ERP'
FILESYSTEM_DISK=public
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
OTP_EXPIRY_MINUTES=15
SESSION_IDLE_MINUTES=30
QUOTATION_DEFAULT_EXPIRY_DAYS=30
BCRYPT_ROUNDS=12
HEALTH_TOKEN=
# Set a strong random token in production; leave empty to disable health endpoint auth in local dev
TRUSTED_PROXIES=
# Comma-separated proxy IPs in production (e.g. 10.0.0.1). Leave empty when not behind a reverse proxy.
CRON_ENABLED=true
VITE_API_URL=/api
VITE_APP_URL=http://localhost:8000
VITE_APP_NAME='Shree Axar ERP'
VITE_STORAGE_URL=http://localhost:8000/storage
VITE_SESSION_IDLE_MINUTES=30
# Optional: default quotation expiry days on create (falls back to settings API, then 30)
# VITE_QUOTATION_DEFAULT_EXPIRY_DAYS=30

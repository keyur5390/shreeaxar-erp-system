# Docker development environment
# Copy to .env.docker and adjust as needed:
#   cp .env.docker.example .env.docker
#
# Run with:
#   docker compose --env-file .env.docker up --build

APP_NAME='Shree Axar ERP'
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_PORT=8001

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3307
DB_DATABASE=shreeaxar_erp
DB_USERNAME=shreeaxar
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

FRONTEND_URL=http://localhost:5174
SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174
VITE_PORT=5174

# Use relative API path so Vite proxies requests to nginx inside Docker
VITE_API_URL=/api
VITE_STORAGE_URL=http://localhost:8001/storage
VITE_SESSION_IDLE_MINUTES=30

RUN_SEED=false
CRON_ENABLED=true
HEALTH_TOKEN=your-secret-token

MAIL_MAILER=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
CACHE_DRIVER=file
